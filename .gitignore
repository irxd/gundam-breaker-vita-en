# Allow-list: ignore everything, then allow only source files.
# Game data must never be committed.
*
!*/
!.gitignore
!CLAUDE.md
!README.md
!notes/**/*.md
!notes/**/*.csv
!tools/**/*.py
!scripts/**/*.py
!scripts/**/*.ps1
# text/ holds English only (id, ja_hash, en, notes). Japanese working copies live in work/ (never tracked).
!text/**/*.csv
!text/**/*.json
!docs/**

# Never allowed, even if they match a rule above
game/
build/
dump/
work/
__pycache__/
*.bin
*.elf
*.self
*.sfo
*.iso
*.vpk
*.cpk
*.psarc
*.xdelta
*.zip
*.7z
